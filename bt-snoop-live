def parse_sbc_config(data):
    """解析 SBC codec specific info"""
    if len(data) < 4:
        return ''
    parts = []
    freq_byte = data[0] & 0xF0
    for mask, val in SBC_SAMPLE_FREQS.items():
        if freq_byte & mask:
            parts.append(val + 'Hz')
            break
    ch_byte = data[0] & 0x0F
    for mask, val in SBC_CHANNELS.items():
        if ch_byte & mask:
            parts.append(val)
            break
    parts.append('bitpool={}-{}'.format(data[2], data[3]))
    return ' '.join(parts)

def parse_aac_config(data):
    """解析 AAC codec specific info"""
    if len(data) < 6:
        return ''
    parts = []
    for mask, val in AAC_OBJ_TYPES.items():
        if data[0] & mask:
            parts.append(val)
            break
    freq_bits = (data[1] << 4) | ((data[2] >> 4) & 0x0F)
    for mask, val in AAC_SAMPLE_FREQS.items():
        if freq_bits & mask:
            parts.append(val + 'Hz')
            break
    ch = (data[2] >> 2) & 0x03
    if ch == 0x02:
        parts.append('Stereo')
    elif ch == 0x01:
        parts.append('Mono')
    vbr = (data[3] >> 7) & 0x01
    bitrate = ((data[3] & 0x7F) << 16) | (data[4] << 8) | data[5]
    if vbr:
        parts.append('VBR')
    if bitrate > 0:
        parts.append('{}kbps'.format(bitrate // 1000))
    return ' '.join(parts)

def parse_lhdc_v234_config(codec_id, data):
    """解析 LHDC 2.0/3.0/4.0 codec specific info"""
    parts = []
    if codec_id == 0x4C32:
        parts.append('LHDC2.0')
    else:
        parts.append('LHDC3.0/4.0')

    if len(data) < 2:
        return ' '.join(parts)

    # Octet 6 (data[0]): LHDC-AR|JAS|16bit|24bit|44.1K|48K|Rsvd|96K
    b6 = data[0]
    freqs = []
    if b6 & 0x08: freqs.append('44.1K')
    if b6 & 0x04: freqs.append('48K')
    if b6 & 0x01: freqs.append('96K')
    bits = []
    if b6 & 0x20: bits.append('16bit')
    if b6 & 0x10: bits.append('24bit')
    features = []
    if b6 & 0x80: features.append('AR')
    if b6 & 0x40: features.append('JAS')

    if freqs: parts.append('/'.join(freqs))
    if bits: parts.append('/'.join(bits))

    # Octet 7 (data[1]): LLAC|LHDC-LL|MaxBitrate(2)|VersionNumber(4)
    b7 = data[1]
    if b7 & 0x80: features.append('LLAC')
    if b7 & 0x40: features.append('LL')
    max_br = (b7 >> 4) & 0x03
    parts.append('max={}'.format(LHDC_MAX_BITRATE.get(max_br, '?')))
    version = b7 & 0x0F
    if version == 1:
        parts.append('ver=2.0')
    elif version == 0x01:
        parts.append('ver=2.0/3.0')

    # Octet 8 (data[2], 4.0 Only): LHDC4.0|LARC|MinBitrate(2)|3rdParty|CompressorFmt(3)
    if len(data) >= 3:
        b8 = data[2]
        if b8 & 0x80: features.append('V4.0')
        if b8 & 0x40: features.append('LARC')
        min_br = (b8 >> 4) & 0x03
        if min_br: parts.append('min=320kbps')
        if b8 & 0x08: features.append('3rdParty')
        comp_fmt = b8 & 0x07
        if comp_fmt == 1: features.append('SplitTWS')
        elif comp_fmt == 2: features.append('SplitPreLR')

    if features: parts.append('[{}]'.format(','.join(features)))
    return ' '.join(parts)

def parse_lhdc_v_config(data):
    """解析 LHDC-V codec specific info"""
    parts = ['LHDC-V']

    if len(data) < 3:
        if data: parts.append('[{}]'.format(data.hex()))
        return ' '.join(parts)

    # Octet 6 (data[0]): Rsvd|Rsvd|44.1K|48K|Rsvd|96K|Rsvd|192K
    b6 = data[0]
    freqs = []
    if b6 & 0x20: freqs.append('44.1K')
    if b6 & 0x10: freqs.append('48K')
    if b6 & 0x04: freqs.append('96K')
    if b6 & 0x01: freqs.append('192K')
    if freqs: parts.append('/'.join(freqs))

    # Octet 7 (data[1]): MinBitrate(2)|MaxBitrate(2)|Rsvd|16bit|24bit|32bit
    b7 = data[1]
    min_br = (b7 >> 6) & 0x03
    max_br = (b7 >> 4) & 0x03
    parts.append('max={}'.format(LHDCV_MAX_BITRATE.get(max_br, '?')))
    parts.append('min={}'.format(LHDCV_MIN_BITRATE.get(min_br, '?')))
    bits = []
    if b7 & 0x04: bits.append('16bit')
    if b7 & 0x02: bits.append('24bit')
    if b7 & 0x01: bits.append('32bit')
    if bits: parts.append('/'.join(bits))

    # Octet 8 (data[2]): Rsvd|Rsvd|Rsvd|5ms|VersionNumber(4)
    b8 = data[2]
    frame_5ms = (b8 >> 4) & 0x01
    if frame_5ms: parts.append('5ms')
    version = b8 & 0x0F
    ver_name = LHDCV_VERSION.get(version, 'v?({})'.format(version))
    parts.append(ver_name)

    # Octet 9 (data[3]): Lossless|LL|Rsvd|Rsvd|Rsvd|Meta|JAS|AR
    features = []
    if len(data) >= 4:
        b9 = data[3]
        if b9 & 0x80: features.append('Lossless')
        if b9 & 0x40: features.append('LL')
        if b9 & 0x04: features.append('Meta')
        if b9 & 0x02: features.append('JAS')
        if b9 & 0x01: features.append('AR')

    if features: parts.append('[{}]'.format(','.join(features)))
    return ' '.join(parts)

def parse_vendor_config(data):
    """解析 Vendor codec specific info (vendor_id=4bytes, codec_id=2bytes)"""
    if len(data) < 6:
        return ''
    vendor_id = struct.unpack('<I', data[0:4])[0]
    codec_id = struct.unpack('<H', data[4:6])[0]
    codec_specific = data[6:]

    # LHDC family (Savitech, vendor_id=0x053A)
    if vendor_id == 0x0000053A:
        if codec_id in (0x4C32, 0x4C33):
            return parse_lhdc_v234_config(codec_id, codec_specific)
        elif codec_id == 0x4C35:
            return parse_lhdc_v_config(codec_specific)

    name = VENDOR_CODECS.get((vendor_id, codec_id),
                             'Vendor(0x{:08X}:0x{:04X})'.format(vendor_id, codec_id))
    if codec_specific:
        return '{} [{}]'.format(name, codec_specific.hex())
    return name

def parse_codec_capability(media_type, codec_type, codec_data):
    """解析 media codec capability/configuration"""
    codec_name = A2DP_CODECS.get(codec_type, '0x{:02X}'.format(codec_type))
    if codec_type == 0x00:  # SBC
        detail = parse_sbc_config(codec_data)
        return 'SBC {}'.format(detail)
    elif codec_type == 0x02:  # AAC
        detail = parse_aac_config(codec_data)
        return 'AAC {}'.format(detail)
    elif codec_type == 0xFF:  # Vendor
        detail = parse_vendor_config(codec_data)
        return detail
    else:
        return '{} [{}]'.format(codec_name, codec_data.hex() if codec_data else '')

def parse_capabilities(payload_data):
    """解析 AVDTP capabilities 列表，提取 codec 信息"""
    caps = []
    i = 0
    while i + 1 < len(payload_data):
        cat_id = payload_data[i]
        cat_len = payload_data[i + 1]
        cat_name = AVDTP_CATEGORIES.get(cat_id, '0x{:02X}'.format(cat_id))
        cat_data = payload_data[i+2:i+2+cat_len]

        if cat_id == 0x07 and cat_len >= 2 and len(cat_data) >= 2:  # MEDIA_CODEC
            media_type = (cat_data[0] >> 4) & 0x0F
            codec_type = cat_data[1]
            codec_data = cat_data[2:]
            codec_info = parse_codec_capability(media_type, codec_type, codec_data)
            caps.append('Codec={}'.format(codec_info))
        elif cat_id == 0x07 and len(cat_data) < 2:
            caps.append('MEDIA_CODEC(fragmented)')
        elif cat_id == 0x04 and cat_len >= 2 and len(cat_data) >= 2:  # CONTENT_PROTECTION
            cp_type = struct.unpack('<H', cat_data[0:2])[0]
            cp_names = {0x01: 'DTCP', 0x02: 'SCMS-T'}
            caps.append('CP={}'.format(cp_names.get(cp_type, '0x{:04X}'.format(cp_type))))
        elif cat_id == 0x08:  # DELAY_REPORTING
            caps.append('DelayReport')
        i += 2 + cat_len
    return caps

def parse_avdtp(payload):
    """解析 AVDTP 信令"""
    if len(payload) < 2:
        return 'AVDTP', '(truncated)'
    # AVDTP header: transaction_label(4) + packet_type(2) + msg_type(2) + signal_id(6)
    hdr0 = payload[0]
    trans_label = (hdr0 >> 4) & 0x0F
    pkt_type = (hdr0 >> 2) & 0x03
    msg_type = hdr0 & 0x03

    if pkt_type == 0:  # Single packet
        if len(payload) < 2:
            return 'AVDTP', '(truncated)'
        sig_id = payload[1] & 0x3F
    else:
        sig_id = 0

    sig_name = AVDTP_SIGS.get(sig_id, "SIG_0x{:02x}".format(sig_id))
    msg_name = AVDTP_MSG_TYPES.get(msg_type, str(msg_type))

    info = "{} {} label={}".format(sig_name, msg_name, trans_label)

    # 追加 SEID 信息
    if sig_id in (0x06, 0x07, 0x08, 0x09, 0x0a) and msg_type == 0 and len(payload) >= 3:
        seid = (payload[2] >> 2) & 0x3F
        info += " SEID={}".format(seid)

    # [AI-GEN] 解析 capabilities 详细参数
    cap_data = None
    if sig_id == 0x03 and msg_type == 0 and len(payload) > 4:
        # SET_CONFIGURATION CMD: ACP_SEID(1) + INT_SEID(1) + capabilities
        acp_seid = (payload[2] >> 2) & 0x3F
        int_seid = (payload[3] >> 2) & 0x3F
        info += " ACP={} INT={}".format(acp_seid, int_seid)
        cap_data = payload[4:]
    elif sig_id == 0x05 and msg_type == 0 and len(payload) > 3:
        # RECONFIGURE CMD: ACP_SEID(1) + capabilities
        acp_seid = (payload[2] >> 2) & 0x3F
        info += " SEID={}".format(acp_seid)
        cap_data = payload[3:]
    elif sig_id in (0x02, 0x0c) and msg_type == 2 and len(payload) > 2:
        # GET_CAPABILITIES / GET_ALL_CAPABILITIES RSP_ACCEPT: capabilities
        cap_data = payload[2:]
    elif sig_id == 0x01 and msg_type == 2 and len(payload) > 2:
        # DISCOVER RSP_ACCEPT: SEID info elements
        seids = []
        i = 2
        while i + 1 < len(payload):
            seid = (payload[i] >> 2) & 0x3F
            in_use = (payload[i] >> 1) & 0x01
            media_type = (payload[i+1] >> 4) & 0x0F
            tsep = (payload[i+1] >> 3) & 0x01
            media_names = {0: 'Audio', 1: 'Video', 2: 'Multimedia'}
            tsep_names = {0: 'SRC', 1: 'SNK'}
            seids.append('{}({}/{}{})'.format(
                seid, media_names.get(media_type, '?'),
                tsep_names.get(tsep, '?'),
                ',InUse' if in_use else ''))
            i += 2
        if seids:
            info += ' [{}]'.format(' '.join(seids))
    elif sig_id == 0x0d and msg_type == 0 and len(payload) >= 5:
        # DELAY_REPORT CMD: SEID + delay(2 bytes, 1/10 ms)
        seid = (payload[2] >> 2) & 0x3F
        delay = struct.unpack('>H', payload[3:5])[0]
        info += " SEID={} delay={:.1f}ms".format(seid, delay / 10.0)

    if cap_data:
        caps = parse_capabilities(cap_data)
        if caps:
            info += ' [{}]'.format(', '.join(caps))

    return 'AVDTP', info

def parse_acl(data):
    """解析 ACL 数据包"""
    if len(data) < 5:
        return 'ACL', '(truncated)', None
    hf = struct.unpack('<H', data[1:3])[0]
    handle = hf & 0x0FFF
    pb_flag = (hf >> 12) & 0x03
    bc_flag = (hf >> 14) & 0x03
    acl_len = struct.unpack('<H', data[3:5])[0]

    if len(data) < 9:
        return 'ACL', "handle=0x{:04x} len={}".format(handle, acl_len), None

    l2cap_len, l2cap_cid = struct.unpack('<HH', data[5:9])
    l2cap_payload = data[9:9+l2cap_len] if len(data) >= 9+l2cap_len else data[9:]

    # L2CAP Signaling Channel
    if l2cap_cid == 0x0001:
        proto, info = parse_l2cap_signaling(l2cap_payload, None)
        return proto, "handle=0x{:04x} {}".format(handle, info), 'l2cap'

    # 已知 CID 名
    cid_name = L2CAP_CIDS.get(l2cap_cid, None)

    # 动态 CID → PSM 映射
    psm = cid_to_psm.get(l2cap_cid, None)
    psm_name = L2CAP_PSMS.get(psm, None) if psm else None

    # AVDTP
    if psm == 0x0019 or psm_name == 'AVDTP':
        if len(l2cap_payload) >= 2:
            proto, avdtp_info = parse_avdtp(l2cap_payload)
            return proto, "handle=0x{:04x} {}".format(handle, avdtp_info), 'avdtp'

    # AVCTP (AVRCP)
    if psm == 0x0017 or psm_name == 'AVCTP':
        return 'AVRCP', "handle=0x{:04x} AVCTP len={}".format(handle, l2cap_len), 'avrcp'

    # SDP
    if psm == 0x0001 or psm_name == 'SDP':
        return 'SDP', "handle=0x{:04x} SDP len={}".format(handle, l2cap_len), 'sdp'

    # RFCOMM (HFP uses RFCOMM)
    if psm == 0x0003 or psm_name == 'RFCOMM':
        return 'RFCOMM', "handle=0x{:04x} RFCOMM len={}".format(handle, l2cap_len), 'hfp'

    # ATT
    if l2cap_cid == 0x0004:
        return 'ATT', "handle=0x{:04x} ATT len={}".format(handle, l2cap_len), 'ble'

    # SMP
    if l2cap_cid == 0x0006:
        return 'SMP', "handle=0x{:04x} SMP len={}".format(handle, l2cap_len), 'ble'

    # Generic L2CAP
    label = psm_name or cid_name or "CID=0x{:04x}".format(l2cap_cid)
    return 'L2CAP', "handle=0x{:04x} {} len={}".format(handle, label, l2cap_len), 'l2cap'


# ── 协议层颜色 ──
PROTO_COLORS = {
    'HCI_CMD': C.RED, 'HCI_EVT': C.RED,
    'L2CAP': C.YEL, 'L2CAP_SIG': C.YEL,
    'AVDTP': C.MAG,
    'AVRCP': C.CYN,
    'SDP': C.GRAY,
    'RFCOMM': C.GRN,
    'ATT': C.BLU, 'SMP': C.BLU,
    'ACL': C.DIM,
    'SCO': C.GRN,
}

PROTO_FILTER_MAP = {
    'hci': ['HCI_CMD', 'HCI_EVT'],
    'l2cap': ['L2CAP', 'L2CAP_SIG'],
    'avdtp': ['AVDTP'],
    'a2dp': ['AVDTP'],
    'avrcp': ['AVRCP'],
    'sdp': ['SDP'],
    'hfp': ['RFCOMM'],
    'acl': ['ACL', 'L2CAP', 'L2CAP_SIG', 'AVDTP', 'AVRCP', 'SDP', 'RFCOMM', 'ATT', 'SMP'],
    'ble': ['ATT', 'SMP'],
}

# ── 包解析入口 ──
def parse_packet(data, flags):
    direction = 'Rcvd' if (flags & 1) else 'Sent'
    if len(data) < 1:
        return direction, 'UNKNOWN', '(empty)', None

    pkt_type = data[0]

    if pkt_type == 0x01:  # HCI Command
        proto, info = parse_hci_cmd(data)
        return direction, proto, info, 'hci'
    elif pkt_type == 0x04:  # HCI Event
        proto, info = parse_hci_evt(data)
        # Num_Completed_Pkts 太多，标记为可过滤
        if 'Num_Completed_Pkts' in info:
            return direction, proto, info, 'hci_noisy'
        return direction, proto, info, 'hci'
    elif pkt_type == 0x02:  # ACL Data
        proto, info, layer = parse_acl(data)
        return direction, proto, info, layer
    elif pkt_type == 0x03:  # SCO
        return direction, 'SCO', "len={}".format(len(data)-1), 'sco'
    else:
        return direction, 'UNKNOWN', "type=0x{:02x} len={}".format(pkt_type, len(data)), None


# ── btsnoop 文件读取 ──
class BtSnoopReader:
    HEADER_SIZE = 16
    RECORD_HEADER_SIZE = 24

    def __init__(self, fileobj):
        self.f = fileobj
        hdr = self.f.read(self.HEADER_SIZE)
        if len(hdr) < self.HEADER_SIZE or hdr[:8] != b'btsnoop\x00':
            raise ValueError("Not a valid btsnoop file")
        self.version, self.datalink = struct.unpack('>II', hdr[8:16])
        self.offset = self.HEADER_SIZE

    def read_packet(self):
        rec_hdr = self.f.read(self.RECORD_HEADER_SIZE)
        if len(rec_hdr) < self.RECORD_HEADER_SIZE:
            return None
        orig_len, incl_len, flags, drops, ts_hi, ts_lo = struct.unpack('>IIIIII', rec_hdr)
        ts = (ts_hi << 32) | ts_lo
        data = self.f.read(incl_len)
        if len(data) < incl_len:
            return None
        self.offset += self.RECORD_HEADER_SIZE + incl_len
        return ts, flags, data

    def tell(self):
        return self.offset


# ── 输出格式化 ──
def format_line(no, time_str, direction, proto, info, layer_filter=None, hide_noisy=True):
    color = PROTO_COLORS.get(proto, C.DIM)

    if direction == 'Sent':
        dir_str = "{}H→C{}".format(C.GRN, C.RST)
    else:
        dir_str = "{}C→H{}".format(C.YEL, C.RST)

    proto_padded = proto.ljust(10)
    return "{}{:>5}{}  {}{:<14}{}  {}  {}{:<10}{}  {}".format(
        C.DIM, no, C.RST,
        C.DIM, time_str, C.RST,
        dir_str,
        color, proto_padded, C.RST,
        info
    )


def print_header():
    print("{}╔═══════════════════════════════════════════════════════╗{}".format(C.BOLD, C.RST))
    print("{}║   BT Snoop Live - Wireshark Terminal Edition v1.0   ║{}".format(C.BOLD, C.RST))
    print("{}╚═══════════════════════════════════════════════════════╝{}".format(C.BOLD, C.RST))

def print_table_header():
    hdr = "{:>5}  {:<14}  {:<3}  {:<10}  {}".format("No", "Time", "Dir", "Protocol", "Info")
    print("{}{}{}".format(C.DIM, hdr, C.RST))
    print("{}{}{}".format(C.DIM, "─" * 80, C.RST))


# ── 主逻辑 ──
def process_file(filepath, layer_filter=None, hide_noisy=True):
    """解析本地 btsnoop 文件"""
    with open(filepath, 'rb') as f:
        reader = BtSnoopReader(f)
        no = 0
        while True:
            pkt = reader.read_packet()
            if pkt is None:
                break
            ts, flags, data = pkt
            direction, proto, info, layer = parse_packet(data, flags)

            if hide_noisy and layer == 'hci_noisy':
                continue
            if layer_filter:
                allowed = set()
                for filt in layer_filter:
                    allowed.update(PROTO_FILTER_MAP.get(filt, [filt]))
                if proto not in allowed:
                    continue

            no += 1
            time_str = ts_to_str(ts)
            print(format_line(no, time_str, direction, proto, info))


def process_live(serial=None, layer_filter=None, hide_noisy=True):
    """实时读取手机 btsnoop"""
    REMOTE_DIR = '/data/misc/bluetooth/logs'
    REMOTE_PATH_FIXED = REMOTE_DIR + '/btsnoop_hci.log'

    adb_prefix = ['adb']
    if serial:
        adb_prefix += ['-s', serial]

    # [AI-GEN] 先尝试固定路径，找不到则自动选最新的带时间戳文件
    check = subprocess.run(adb_prefix + ['shell', 'ls', '-la', REMOTE_PATH_FIXED],
                          capture_output=True, text=True)
    if check.returncode == 0:
        REMOTE_PATH = REMOTE_PATH_FIXED
    else:
        find_latest = subprocess.run(
            adb_prefix + ['shell', 'ls -t {}/btsnoop_hci*.log 2>/dev/null | head -1'.format(REMOTE_DIR)],
            capture_output=True, text=True)
        REMOTE_PATH = find_latest.stdout.strip()
        if not REMOTE_PATH:
            print("{}错误: 在 {} 下找不到 btsnoop_hci*.log{}".format(C.RED, REMOTE_DIR, C.RST))
            print("请在开发者选项中开启「启用蓝牙 HCI 信息收集日志」")
            return

    print("{}读取 {}...{}".format(C.DIM, REMOTE_PATH, C.RST))
    print("{}Ctrl+C 退出{}".format(C.DIM, C.RST))
    print_table_header()

    tmpfile = tempfile.NamedTemporaryFile(delete=False, suffix='.bin')
    tmppath = tmpfile.name
    tmpfile.close()

    no = 0
    last_size = 0

    try:
        while True:
            # 获取文件大小
            stat_res = subprocess.run(
                adb_prefix + ['shell', 'stat', '-c', '%s', REMOTE_PATH],
                capture_output=True, text=True)
            if stat_res.returncode != 0:
                time.sleep(1)
                continue
            cur_size = int(stat_res.stdout.strip())

            if cur_size < last_size:
                # 文件被重置（蓝牙重启等）
                last_size = 0
                no = 0
                cid_to_psm.clear()
                print("\n{}--- btsnoop 文件已重置 ---{}".format(C.YEL, C.RST))
                print_table_header()

            if cur_size > last_size:
                if last_size == 0:
                    # 首次读取：拉整个文件
                    subprocess.run(adb_prefix + ['shell', 'cat', REMOTE_PATH],
                                  stdout=open(tmppath, 'wb'), stderr=subprocess.DEVNULL)
                else:
                    # 增量读取
                    skip = last_size
                    cmd = "dd if={} bs=1 skip={} count={} 2>/dev/null".format(
                        REMOTE_PATH, skip, cur_size - last_size)
                    subprocess.run(adb_prefix + ['shell', cmd],
                                  stdout=open(tmppath, 'wb'), stderr=subprocess.DEVNULL)

                with open(tmppath, 'rb') as f:
                    if last_size == 0:
                        try:
                            reader = BtSnoopReader(f)
                        except ValueError:
                            last_size = cur_size
                            time.sleep(0.5)
                            continue
                    else:
                        pass  # 增量数据，直接解析 record

                    while True:
                        rec_hdr = f.read(24)
                        if len(rec_hdr) < 24:
                            break
                        orig_len, incl_len, flags, drops, ts_hi, ts_lo = struct.unpack('>IIIIII', rec_hdr)
                        ts = (ts_hi << 32) | ts_lo
                        pkt_data = f.read(incl_len)
                        if len(pkt_data) < incl_len:
                            break

                        direction, proto, info, layer = parse_packet(pkt_data, flags)

                        if hide_noisy and layer == 'hci_noisy':
                            continue
                        if layer_filter:
                            allowed = set()
                            for filt in layer_filter:
                                allowed.update(PROTO_FILTER_MAP.get(filt, [filt]))
                            if proto not in allowed:
                                continue

                        no += 1
                        time_str = ts_to_str(ts)
                        print(format_line(no, time_str, direction, proto, info), flush=True)

                last_size = cur_size

            time.sleep(0.5)

    except KeyboardInterrupt:
        print("\n{}退出{}".format(C.DIM, C.RST))
    finally:
        try:
            os.unlink(tmppath)
        except:
            pass


def start_web_mode(port=8000):
    """启动 Web UI 模式"""
    import webbrowser
    web_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'btsnoop-web', 'backend')
    if not os.path.isdir(web_dir):
        print("{}错误: 未找到 btsnoop-web/backend 目录{}".format(C.RED, C.RST))
        print("请确保在项目根目录下运行，或先安装 Web 组件")
        sys.exit(1)
    print("{}╔══════════════════════════════════════╗{}".format(C.CYN, C.RST))
    print("{}║   bt-snoop-live Web UI Mode          ║{}".format(C.CYN, C.RST))
    print("{}╚══════════════════════════════════════╝{}".format(C.CYN, C.RST))
    print()
    print("  启动 Web 服务: {}http://localhost:{}{}".format(C.GRN, port, C.RST))
    print("  按 Ctrl+C 停止")
    print()
    webbrowser.open(f"http://localhost:{port}")
    os.chdir(web_dir)
    os.execvp('python3', ['python3', 'server.py'])


def main():
    parser = argparse.ArgumentParser(
        description='蓝牙 btsnoop 实时解析工具（Wireshark 终端版）',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog='''
协议层过滤: hci, l2cap, avdtp, a2dp, avrcp, hfp, sdp, acl, ble
示例:
  bt-snoop-live                          # 实时全部
  bt-snoop-live --filter avdtp           # 只看 AVDTP 信令
  bt-snoop-live --filter hci             # 只看 HCI
  bt-snoop-live --filter a2dp            # 只看 A2DP (=AVDTP)
  bt-snoop-live --filter hci,avdtp       # HCI + AVDTP
  bt-snoop-live -f btsnoop_hci.log       # 解析本地文件
  bt-snoop-live -f dump.cfa --filter hci # 解析 .cfa 文件
''')
    parser.add_argument('-f', '--file', help='从本地 btsnoop/cfa 文件解析')
    parser.add_argument('-s', '--serial', help='adb 设备序列号')
    parser.add_argument('--filter', help='协议层过滤（逗号分隔）')
    parser.add_argument('--show-noisy', action='store_true', help='显示高频事件 (Num_Completed_Pkts)')
    parser.add_argument('--web', action='store_true', help='启动 Web UI 模式')
    parser.add_argument('--port', type=int, default=8000, help='Web 服务端口 (默认 8000)')
    args = parser.parse_args()

    if args.web:
        start_web_mode(args.port)
        return

    layer_filter = None
    if args.filter:
        layer_filter = set(args.filter.lower().split(','))

    print_header()
    if layer_filter:
        print("{}Filter: {}{}".format(C.DIM, ', '.join(layer_filter), C.RST))

    if args.file:
        print_table_header()
        process_file(args.file, layer_filter, not args.show_noisy)
    else:
        process_live(args.serial, layer_filter, not args.show_noisy)


if __name__ == '__main__':
    main()
