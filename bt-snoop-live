def ts_to_str(ts_us):
    try:
        dt = datetime.datetime(2000, 1, 1) + datetime.timedelta(microseconds=ts_us - 0x00dcddb30f2f8000)
        return dt.strftime('%H:%M:%S.%f')[:-3]
    except:
        return '??:??:??.???'

# ── 解析函数 ──
def parse_hci_cmd(data):
    if len(data) < 4:
        return 'HCI_CMD', '(truncated)'
    opcode = struct.unpack('<H', data[1:3])[0]
    plen = data[3]
    ogf = (opcode >> 10) & 0x3F
    ocf = opcode & 0x03FF
    name = HCI_CMDS.get(opcode, "0x{:04x}".format(opcode))
    return 'HCI_CMD', "{} (0x{:04x}) plen={}".format(name, opcode, plen)

def parse_hci_evt(data):
    if len(data) < 3:
        return 'HCI_EVT', '(truncated)'
    evt_code = data[1]
    plen = data[2]
    evt_name = HCI_EVTS.get(evt_code, "0x{:02x}".format(evt_code))

    if evt_code == 0x0e and len(data) >= 7:  # Command Complete
        num_pkts = data[3]
        cc_op = struct.unpack('<H', data[4:6])[0]
        cc_name = HCI_CMDS.get(cc_op, "0x{:04x}".format(cc_op))
        status = data[6] if len(data) > 6 else -1
        st_str = " status={}".format(status) if status > 0 else ""
        return 'HCI_EVT', "Cmd_Complete: {}{}".format(cc_name, st_str)
    elif evt_code == 0x0f and len(data) >= 7:  # Command Status
        status = data[3]
        cs_op = struct.unpack('<H', data[5:7])[0]
        cs_name = HCI_CMDS.get(cs_op, "0x{:04x}".format(cs_op))
        return 'HCI_EVT', "Cmd_Status: {} status={}".format(cs_name, status)
    elif evt_code == 0x03 and len(data) >= 14:  # Connection Complete
        status = data[3]
        handle = struct.unpack('<H', data[4:6])[0]
        addr = ':'.join("{:02x}".format(b) for b in reversed(data[6:12]))
        return 'HCI_EVT', "Conn_Complete handle=0x{:04x} addr={} st={}".format(handle, addr, status)
    elif evt_code == 0x05 and len(data) >= 7:  # Disconnection Complete
        status = data[3]
        handle = struct.unpack('<H', data[4:6])[0]
        reason = data[6]
        return 'HCI_EVT', "Disconn_Complete handle=0x{:04x} reason=0x{:02x}".format(handle, reason)
    elif evt_code == 0x14 and len(data) >= 7:  # Mode Change
        status = data[3]
        handle = struct.unpack('<H', data[4:6])[0]
        mode = data[6]
        modes = {0: 'Active', 1: 'Hold', 2: 'Sniff', 3: 'Park'}
        return 'HCI_EVT', "Mode_Change: {} handle=0x{:04x}".format(modes.get(mode, str(mode)), handle)
    elif evt_code == 0x13 and len(data) >= 5:  # Num Completed Packets
        num = data[3]
        return 'HCI_EVT', "Num_Completed_Pkts n={}".format(num)
    elif evt_code == 0x3e and len(data) >= 4:  # LE Meta
        sub = data[3]
        le_names = {0x01: 'LE_Conn_Complete', 0x02: 'LE_Adv_Report',
                    0x04: 'LE_Read_Remote_Features_Complete',
                    0x07: 'LE_Data_Length_Change', 0x0a: 'LE_Enhanced_Conn_Complete',
                    0x0d: 'LE_Extended_Adv_Report'}
        sub_name = le_names.get(sub, "sub=0x{:02x}".format(sub))
        return 'HCI_EVT', "LE_Meta: {}".format(sub_name)
    else:
        return 'HCI_EVT', "{} plen={}".format(evt_name, plen)

def parse_l2cap_signaling(payload, direction):
    """解析 L2CAP 信令"""
    if len(payload) < 4:
        return 'L2CAP_SIG', '(truncated)'
    code = payload[0]
    ident = payload[1]
    sig_len = struct.unpack('<H', payload[2:4])[0]
    code_name = L2CAP_SIG_CODES.get(code, "code=0x{:02x}".format(code))
    info = "{} id={}".format(code_name, ident)

    if code == 0x02 and len(payload) >= 8:  # Connection Request
        psm = struct.unpack('<H', payload[4:6])[0]
        scid = struct.unpack('<H', payload[6:8])[0]
        psm_name = L2CAP_PSMS.get(psm, "0x{:04x}".format(psm))
        info = "CONN_REQ PSM={} SCID=0x{:04x}".format(psm_name, scid)
        cid_to_psm[scid] = psm
    elif code == 0x03 and len(payload) >= 12:  # Connection Response
        dcid = struct.unpack('<H', payload[4:6])[0]
        scid = struct.unpack('<H', payload[6:8])[0]
        result = struct.unpack('<H', payload[8:10])[0]
        results = {0: 'Success', 1: 'Pending', 2: 'PSM_Not_Supported', 3: 'Security_Block', 4: 'No_Resources'}
        info = "CONN_RSP DCID=0x{:04x} SCID=0x{:04x} {}".format(dcid, scid, results.get(result, str(result)))
        if scid in cid_to_psm:
            cid_to_psm[dcid] = cid_to_psm[scid]
    elif code == 0x04 and len(payload) >= 8:  # Config Request
        dcid = struct.unpack('<H', payload[4:6])[0]
        info = "CONFIG_REQ DCID=0x{:04x}".format(dcid)
    elif code == 0x05 and len(payload) >= 10:  # Config Response
        scid = struct.unpack('<H', payload[4:6])[0]
        result = struct.unpack('<H', payload[8:10])[0]
        info = "CONFIG_RSP SCID=0x{:04x} result={}".format(scid, result)
    elif code == 0x06 and len(payload) >= 8:  # Disconnection Request
        dcid = struct.unpack('<H', payload[4:6])[0]
        scid = struct.unpack('<H', payload[6:8])[0]
        info = "DISCONN_REQ DCID=0x{:04x} SCID=0x{:04x}".format(dcid, scid)
    elif code == 0x07 and len(payload) >= 8:  # Disconnection Response
        dcid = struct.unpack('<H', payload[4:6])[0]
        scid = struct.unpack('<H', payload[6:8])[0]
        info = "DISCONN_RSP DCID=0x{:04x} SCID=0x{:04x}".format(dcid, scid)

    return 'L2CAP_SIG', info


